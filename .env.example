# Copy to .env for local dev (npm run dev reads it via `node --env-file` /
# tsx automatically picks up .env). In Vercel, set these as Project env vars
# - never commit a real .env.

# Postgres (Vercel Postgres / Neon / Supabase all work - any standard pg URL)
DATABASE_URL=postgres://user:password@host:5432/toroto_privacy_ia

# Vercel Blob (Storage > Blob in the Vercel dashboard)
BLOB_READ_WRITE_TOKEN=

# Google Gemini (https://aistudio.google.com/apikey) - server-side only,
# NEVER expose this to the client.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Google OAuth (Google Cloud Console > Credentials > OAuth Client ID, type
# "Web application"). Restrict Authorized redirect URI to
# <your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
ALLOWED_EMAIL_DOMAIN=toroto.mx

# Session cookie signing secret - generate with `openssl rand -hex 32`
SESSION_SECRET=

NODE_ENV=development
