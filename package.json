{
  "name": "toroto-privacy-ia",
  "version": "0.1.0",
  "description": "Toroto Privacy IA - AI-assisted redaction of sensitive information in assembly minutes/annexes, with mandatory human-in-the-loop review before publication.",
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && npm run build:client",
    "build:client": "cd client && npm install && npm run build",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@google/genai": "^0.9.0",
    "@types/express": "^5.0.0",
    "@vercel/blob": "^0.27.0",
    "@vercel/functions": "^3.9.8",
    "ajv": "^8.17.1",
    "connect-pg-simple": "^10.0.0",
    "express": "^4.18.2",
    "express-session": "^1.18.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
