{
  "buildCommand": "npm run build",
  "functions": {
    "src/index.ts": {
      "maxDuration": 300,
      "includeFiles": "client/dist/**"
    },
    "api/redact.py": { "maxDuration": 60, "memory": 1024 }
  },
  "rewrites": [
    { "source": "/((?!api/redact).*)", "destination": "/src/index.ts" }
  ]
}
